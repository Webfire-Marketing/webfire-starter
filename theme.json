{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#fbfaf7" },
				{ "slug": "base-2", "name": "Base 2", "color": "#f1efe9" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1b1b19" },
				{ "slug": "contrast-2", "name": "Contrast 2", "color": "#5d5b55" },
				{ "slug": "line", "name": "Line", "color": "#dedbd2" }
			]
		},
		"layout": { "contentSize": "680px", "wideSize": "1320px" },
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "1rem" },
				{ "slug": "30", "name": "3", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
				{ "slug": "40", "name": "4", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "50", "name": "5", "size": "clamp(2.5rem, 5vw, 4.5rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(4rem, 9vw, 8rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body", "name": "Inter Tight",
					"fontFamily": "\"Inter Tight\", system-ui, sans-serif",
					"fontFace": [ { "fontFamily": "Inter Tight", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-tight.woff2" ] } ]
				},
				{
					"slug": "heading", "name": "Newsreader",
					"fontFamily": "Newsreader, Georgia, serif",
					"fontFace": [ { "fontFamily": "Newsreader", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/newsreader.woff2" ] } ]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "4.5rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"spacing": { "padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" }, "blockGap": "1.25rem" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6", "letterSpacing": "-0.005em" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "400", "lineHeight": "1.1", "letterSpacing": "-0.02em" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.02" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } },
				":focus": { "outline": { "color": "currentColor", "style": "solid", "width": "1px", "offset": "3px" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": { "fontWeight": "500", "fontSize": "var(--wp--preset--font-size--small)" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast-2)" } }
			},
			"caption": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" }, "color": { "text": "var(--wp--preset--color--contrast-2)" } }
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" } },
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "400" }, "elements": { "link": { "typography": { "textDecoration": "none" } } } },
			"core/post-title": { "elements": { "link": { "typography": { "textDecoration": "none" } } } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--line)" }, "border": { "width": "1px" } },
			"core/details": { "border": { "bottom": { "color": "var(--wp--preset--color--line)", "width": "1px", "style": "solid" } }, "spacing": { "padding": { "top": "1.1rem", "bottom": "1.1rem" } } },
			"core/image": { "border": { "radius": "2px" } },
			"core/post-featured-image": { "border": { "radius": "2px" } }
		}
	},
	"customTemplates": [
		{ "name": "page-no-title", "title": "Seite ohne Titel", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
